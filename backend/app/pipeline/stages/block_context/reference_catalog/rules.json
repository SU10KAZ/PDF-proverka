{
  "schema_version": 1,
  "rules_version": "2026.07.13-1",
  "selection": {
    "scope": ["discipline", "profile_id"],
    "exclude_current_block": true,
    "prefer_complete_candidates": true,
    "strongest_match_min": 0.08,
    "top_alternatives": 3,
    "weights": {
      "semantic": 0.35,
      "subtype": 0.4,
      "structure": 0.15,
      "quality": 0.1
    },
    "quality_weights": {
      "complete": 0.5,
      "covered_facts": 0.3,
      "evidence": 0.2
    },
    "confidence": {
      "high_min": 0.55,
      "medium_min": 0.35
    }
  },
  "classification": {
    "primary_source": "chandra_description",
    "ignored_chandra_fields": ["Текст на чертеже", "Сущности", "ENRICHED"],
    "fallback_source": "strict_pdf_vector_region"
  },
  "text_scope": {
    "mode": "strict_polygon_or_rectangle",
    "outside_margin": 0.0,
    "invalid_region": "empty",
    "empty_region": "image_only"
  },
  "generic_subtypes": [
