{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison_scope.schema.json",
  "title": "Deterministic TEXT to GRAPHIC scope join",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scope_join_version", "document_binding", "page_convention", "versions", "source_signature", "source_artifacts", "scopes", "diagnostics"],
  "properties": {
    "schema_version": {"const": "text-graphic-scope-join.v3"},
    "kind": {"const": "stage_comparison_text_graphic_scope_join"},
    "scope_join_version": {"const": "document-version-page-scope-join-v3"},
    "document_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_version", "state", "reason_codes", "pair_documents", "sides"],
      "properties": {
        "binding_version": {"const": "document-binding-v2"},
        "state": {"enum": ["DOCUMENT_BINDING_PROVEN", "DOCUMENT_BINDING_MISMATCH", "DOCUMENT_BINDING_UNPROVEN", "DOCUMENT_BINDING_AMBIGUOUS", "DOCUMENT_BINDING_ERROR"]},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pair_documents": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["LEFT", "RIGHT"],
          "properties": {"LEFT": {"$ref": "#/$defs/document_reference"}, "RIGHT": {"$ref": "#/$defs/document_reference"}}
        },
        "sides": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LEFT", "RIGHT"],
          "properties": {"LEFT": {"$ref": "#/$defs/binding_side"}, "RIGHT": {"$ref": "#/$defs/binding_side"}}
        }
      }
    },
    "page_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "text", "graphic", "canonical", "text_to_canonical", "identity", "cross_document"],
      "properties": {
        "version": {"const": "document-version-page-identity-v3"},
        "text": {"const": "pdf_page_1based"},
        "graphic": {"const": "page_index_0based"},
        "canonical": {"const": "page_index_0based"},
        "text_to_canonical": {"const": "pdf_page_1based - 1"},
        "identity": {"const": "document + version + canonical page"},
        "cross_document": {"const": "PROVEN parent page relation only"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_bridge", "side_bridge", "parent_page_relation"],
      "properties": {
        "entity_bridge": {"type": "string", "minLength": 1},
        "side_bridge": {"type": "string", "minLength": 1},
        "parent_page_relation": {"const": "parent-page-relation.v1"}
      }
    },
    "source_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_artifacts": {"type": "object"},
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_ref", "scope_level", "status", "reason_codes", "text_scope", "graphic_scope_group", "child_block_scopes"],
        "properties": {
          "scope_ref": {"type": "string", "pattern": "^scope_[a-f0-9]{20}$"},
          "scope_level": {"const": "SHEET"},
          "status": {"enum": ["RESOLVED", "UNRESOLVED_SCOPE"]},
          "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "text_scope": {"type": ["object", "null"]},
          "graphic_scope_group": {"type": ["object", "null"]},
          "child_block_scopes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope_ref", "block_pair"],
              "properties": {
                "scope_ref": {"type": "string", "pattern": "^block_scope_[a-f0-9]{20}$"},
                "block_pair": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_sheet_groups", "graphic_scope_groups", "resolved_scopes", "unresolved_scopes", "resolved_child_block_scopes"],
      "properties": {
        "text_sheet_groups": {"type": "integer", "minimum": 0},
        "graphic_scope_groups": {"type": "integer", "minimum": 0},
        "resolved_scopes": {"type": "integer", "minimum": 0},
        "unresolved_scopes": {"type": "integer", "minimum": 0},
        "resolved_child_block_scopes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "document_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_code", "version_id", "storage_identity", "source_path", "provenance"],
      "properties": {
        "document_code": {"type": ["string", "null"], "minLength": 1},
        "version_id": {"type": ["string", "null"], "minLength": 1},
        "storage_identity": {"type": ["string", "null"], "minLength": 1},
        "source_path": {"type": ["string", "null"], "minLength": 1},
        "provenance": {"enum": ["ARTIFACT", "CLI_ARGUMENT", "ABSENT"]}
      }
    },
    "binding_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_codes", "expected_document", "observed_documents", "unbound_block_pairs"],
      "properties": {
        "state": {"enum": ["DOCUMENT_BINDING_PROVEN", "DOCUMENT_BINDING_MISMATCH", "DOCUMENT_BINDING_UNPROVEN", "DOCUMENT_BINDING_AMBIGUOUS", "DOCUMENT_BINDING_ERROR"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_document": {"$ref": "#/$defs/document_reference"},
        "observed_documents": {"type": "array", "items": {"$ref": "#/$defs/document_reference"}},
        "unbound_block_pairs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
