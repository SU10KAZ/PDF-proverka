{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity_links.schema.json",
  "title": "Deterministic TEXT/GRAPHIC Entity Links",
  "description": "Additive identity bridge only; it neither mutates source artifacts nor merges project changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "bridge_version",
    "normalizer_version",
    "input_entity_ids",
    "links",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "entity-bridge.v1"},
    "kind": {"const": "text_graphic_entity_links"},
    "bridge_version": {"const": "deterministic-entity-bridge-v1"},
    "normalizer_version": {"const": "entity-normalizer-v1"},
    "input_entity_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "graphic"],
      "properties": {
        "text": {"$ref": "#/$defs/string_array"},
        "graphic": {"$ref": "#/$defs/string_array"}
      }
    },
    "links": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity_link"}
    },
    "diagnostics": {"$ref": "#/$defs/diagnostics"}
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "original", "canonical"],
      "properties": {
        "source": {"enum": ["TEXT", "GRAPHIC"]},
        "original": {"type": "string", "minLength": 1},
        "canonical": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "level",
        "outcome",
        "tokens",
        "normalization",
        "context"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 0, "maximum": 4},
        "outcome": {"enum": ["MATCH", "CONFLICT", "AMBIGUITY"]},
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "normalization": {
          "type": "array",
          "items": {"$ref": "#/$defs/normalization"}
        },
        "context": {"type": "object"}
      }
    },
    "entity_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_link_id",
        "text_entity_id",
        "graphic_entity_id",
        "relation",
        "confidence",
        "evidence"
      ],
      "properties": {
        "entity_link_id": {"type": "string", "minLength": 1},
        "text_entity_id": {"type": "string", "minLength": 1},
        "graphic_entity_id": {"type": "string", "minLength": 1},
        "relation": {"enum": ["SAME_ENTITY", "POSSIBLE_ENTITY", "UNKNOWN"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"relation": {"const": "SAME_ENTITY"}},
            "required": ["relation"]
          },
          "then": {"properties": {"confidence": {"const": "HIGH"}}}
        },
        {
          "if": {
            "properties": {"relation": {"const": "POSSIBLE_ENTITY"}},
            "required": ["relation"]
          },
          "then": {"properties": {"confidence": {"enum": ["MEDIUM", "LOW"]}}}
        },
        {
          "if": {
            "properties": {"relation": {"const": "UNKNOWN"}},
            "required": ["relation"]
          },
          "then": {"properties": {"confidence": {"const": "UNKNOWN"}}}
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SAME_ENTITY", "POSSIBLE_ENTITY", "UNKNOWN"],
      "properties": {
        "SAME_ENTITY": {"type": "integer", "minimum": 0},
        "POSSIBLE_ENTITY": {"type": "integer", "minimum": 0},
        "UNKNOWN": {"type": "integer", "minimum": 0}
      }
    },
    "confidence_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"],
      "properties": {
        "HIGH": {"type": "integer", "minimum": 0},
        "MEDIUM": {"type": "integer", "minimum": 0},
        "LOW": {"type": "integer", "minimum": 0},
        "UNKNOWN": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_entity_count",
        "graphic_entity_count",
        "candidate_link_count",
        "relation_counts",
        "confidence_counts",
        "unresolved_text_entity_ids",
        "unresolved_graphic_entity_ids"
      ],
      "properties": {
        "text_entity_count": {"type": "integer", "minimum": 0},
        "graphic_entity_count": {"type": "integer", "minimum": 0},
        "candidate_link_count": {"type": "integer", "minimum": 0},
        "relation_counts": {"$ref": "#/$defs/counts"},
        "confidence_counts": {"$ref": "#/$defs/confidence_counts"},
        "unresolved_text_entity_ids": {"$ref": "#/$defs/string_array"},
        "unresolved_graphic_entity_ids": {"$ref": "#/$defs/string_array"}
      }
    }
  }
}
