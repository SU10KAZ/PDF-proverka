{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text_entities.schema.json",
  "title": "Stage 5.3 TEXT Entities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "producer_version",
    "normalizer_version",
    "source_signature",
    "source_artifact",
    "entities",
    "quality_report"
  ],
  "properties": {
    "schema_version": {"const": "text-entities.v1"},
    "kind": {"const": "stage_comparison_text_entities"},
    "producer_version": {"const": "stage5-3-text-entity-producer-v1"},
    "normalizer_version": {"const": "entity-normalizer-v1"},
    "source_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact": {"$ref": "#/$defs/source_artifact"},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "quality_report": {"$ref": "#/$defs/quality_report"}
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "version",
        "pair_id",
        "source_signature",
        "artifact_digest",
        "evidence_index_digest",
        "evidence_index_version"
      ],
      "properties": {
        "kind": {"const": "stage_comparison_high_level_project_changes"},
        "schema_version": {"const": "1.0"},
        "version": {"const": 1},
        "pair_id": {"type": "string", "minLength": 1},
        "source_signature": {"type": ["string", "null"]},
        "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_index_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "evidence_index_version": {"type": ["string", "null"]}
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "field", "rule"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "canonical_name",
        "display_names",
        "entity_type",
        "domain_subtype",
        "system",
        "parent_context",
        "sheet_groups",
        "pages",
        "evidence_ids",
        "fragment_ids",
        "source_change_ids",
        "confidence",
        "provenance"
      ],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^txt_ent_[0-9a-f]{20}$"},
        "canonical_name": {"type": "string", "minLength": 1},
        "display_names": {
          "allOf": [
            {"$ref": "#/$defs/string_array"},
            {"minItems": 1}
          ]
        },
        "entity_type": {
          "enum": ["SYSTEM", "EQUIPMENT", "FUNCTIONAL_NODE", "ROOM", "MATERIAL", "GROUP", "OTHER"]
        },
        "domain_subtype": {"type": ["string", "null"]},
        "system": {"type": ["string", "null"]},
        "parent_context": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "sheet_groups": {"$ref": "#/$defs/string_array"},
        "pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/string_array"},
            {"minItems": 1}
          ]
        },
        "fragment_ids": {"$ref": "#/$defs/string_array"},
        "source_change_ids": {"$ref": "#/$defs/string_array"},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_artifact_digest", "evidence_index_digest", "producer_version", "normalizer_version", "mentions"],
          "properties": {
            "source_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "evidence_index_digest": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              ]
            },
            "producer_version": {"const": "stage5-3-text-entity-producer-v1"},
            "normalizer_version": {"const": "entity-normalizer-v1"},
            "mentions": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/mention"}
            }
          }
        }
      }
    },
    "quality_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_evidence",
        "total_source_candidates",
        "produced_entities",
        "dropped_noise",
        "ambiguous",
        "duplicated",
        "unresolved_context"
      ],
      "properties": {
        "source_evidence": {"type": "integer", "minimum": 0},
        "total_source_candidates": {"type": "integer", "minimum": 0},
        "produced_entities": {"type": "integer", "minimum": 0},
        "dropped_noise": {"type": "integer", "minimum": 0},
        "ambiguous": {"type": "integer", "minimum": 0},
        "duplicated": {"type": "integer", "minimum": 0},
        "unresolved_context": {"type": "integer", "minimum": 0}
      }
    }
  }
}
