# PDF-proverka — пример .env (не коммитить реальные секреты).

# --- PAID API KILL-SWITCH ---
# PAID_API_ENABLED=false       → guard блокирует все платные внешние вызовы
# PAID_API_DAILY_LIMIT_USD=N   → жёсткий потолок $/день; 0 = без лимита
PAID_API_ENABLED=false
PAID_API_DAILY_LIMIT_USD=0.0

# --- Внешние провайдеры (опционально) ---
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# --- Локальный LM Studio через ngrok + Basic Auth ---
# CHANDRA_BASE_URL=https://your-ngrok-url
# NGROK_AUTH_USER=
# NGROK_AUTH_PASS=

# --- Stage Comparison: allowlist исходных папок ---
# AUDIT_STAGE_COMPARISON_ROOTS=/abs/path/to/comparison_sources

# --- Stage Comparison Text LLM (Claude Code subscription) ---
STAGE_COMPARISON_TEXT_LLM_ENABLED=false
STAGE_COMPARISON_TEXT_LLM_PROVIDER=claude_code
STAGE_COMPARISON_TEXT_LLM_MODEL=sonnet
STAGE_COMPARISON_TEXT_LLM_TIMEOUT_SEC=720
STAGE_COMPARISON_TEXT_LLM_MAX_CHARS=350000

# --- Stage Comparison Unified Analysis (Claude Opus via subscription) ---
# Используется в unified pipeline: enriched MD (Qwen) → Claude Opus для
# смыслового сравнения стадий. Внешний Anthropic API НЕ дёргается — только
# Claude Code subscription через CLI.
STAGE_COMPARISON_ENRICHED_COMPARE_ENABLED=false
STAGE_COMPARISON_ENRICHED_COMPARE_PROVIDER=claude_code
STAGE_COMPARISON_ENRICHED_COMPARE_MODEL=opus
STAGE_COMPARISON_ENRICHED_COMPARE_TIMEOUT_SEC=900
STAGE_COMPARISON_ENRICHED_COMPARE_MAX_CHARS=600000

# --- Stage Comparison Graphic LLM (Local OpenAI-compatible / LM Studio) ---
# Активирует локальный VLM provider для графического сравнения в разделе
# «Сравнение стадий». Использует только local LM Studio endpoint через
# ngrok + Basic Auth (NGROK_AUTH_USER / NGROK_AUTH_PASS).
#
# Не использует OpenRouter / Gemini / api.openai.com / anthropic.com.
# По умолчанию provider=existing (старое поведение).
#
# STAGE_COMPARISON_GRAPHIC_LLM_PROVIDER=local_openai_compatible
# STAGE_COMPARISON_GRAPHIC_LLM_BASE_URL=https://your-ngrok-url
# STAGE_COMPARISON_GRAPHIC_LLM_MODEL=qwen/qwen3.6-35b-a3b
# STAGE_COMPARISON_GRAPHIC_LLM_FALLBACK_MODEL=qwen3.6-35b-a3b-mtp
# STAGE_COMPARISON_GRAPHIC_LLM_TEMPERATURE=0.0
# STAGE_COMPARISON_GRAPHIC_LLM_MAX_TOKENS=5500   # рекомендуемый default (compact v4 prompt).
                                                  # Live benchmark 2026-05-26 (4 heavy HVAC blocks):
                                                  #   max=4000  → 2/4 success, avg 96s, max 266s (V2 + fallback mtp)
                                                  #   max=5500  → 4/4 success, avg 27s, max 32s  ← default
                                                  #   max=7500  → 4/4 success, avg 34s, max 43s — больше деталей, slower
# STAGE_COMPARISON_GRAPHIC_LLM_MAX_CONTINUATIONS=3  # primary + до 3 continuations при continues=true
                                                    # (на v4 prompt'е каждый primary упирается в length →
                                                    # salvage возвращает partial → continuation добивает)
# STAGE_COMPARISON_GRAPHIC_LLM_TIMEOUT_SEC=300
# STAGE_COMPARISON_GRAPHIC_LLM_IMAGE_LONG_SIDE=1100
# STAGE_COMPARISON_GRAPHIC_LLM_AUTH=basic
# STAGE_COMPARISON_GRAPHIC_LLM_ENABLE_MODEL_LOAD=true
# STAGE_COMPARISON_GRAPHIC_LLM_LOAD_CONTEXT_LENGTH=16000
#
# Защита LM Studio:
#   PROTECT_MODELS — CSV-список model_key, которые нельзя выгружать. По
#                    умолчанию chandra-ocr-2 (production OCR). Если эта модель
#                    была loaded до запроса и пропадёт после load qwen —
#                    автоматически восстанавливается через /api/v1/models/load
#                    с config из pre-request snapshot, с warning'ом.
#   UNLOAD_AFTER_REQUEST — после успешного single graphic-diff выгружать
#                          primary/fallback (но не PROTECT_MODELS).
#   UNLOAD_AFTER_BATCH   — то же, но в конце batch job.
# STAGE_COMPARISON_GRAPHIC_LLM_PROTECT_MODELS=chandra-ocr-2
# STAGE_COMPARISON_GRAPHIC_LLM_UNLOAD_AFTER_REQUEST=false
# STAGE_COMPARISON_GRAPHIC_LLM_UNLOAD_AFTER_BATCH=false
