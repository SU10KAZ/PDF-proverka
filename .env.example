# PDF-proverka — пример .env (не коммитить реальные секреты).

# --- PORTAL AUTH (простая защита портала логином/паролем) ---
# Лёгкая session-cookie аутентификация для 3-4 сотрудников. Без БД, ролей,
# регистрации. По умолчанию ВЫКЛЮЧЕНА — портал работает как раньше.
#
# Включить защиту:
PORTAL_AUTH_ENABLED=false
#
# Список учёток: 'логин:pbkdf2-хеш' через запятую. ВАЖНО: значение в ОДИНАРНЫХ
# кавычках — хеш содержит '$', иначе .env-загрузчик попытается раскрыть его как
# переменную. Хеш генерируется helper-скриптом (см. ниже), пароли в открытом
# виде НЕ хранятся.
#   python backend/scripts/hash_portal_password.py --user ivan
# PORTAL_AUTH_USERS='ivan:$pbkdf2-sha256$29000$...,petr:$pbkdf2-sha256$29000$...'
#
# Секрет для подписи session-cookie (длинная случайная строка). Без него
# сессии живут только до рестарта процесса.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PORTAL_SESSION_SECRET=
#
# Срок жизни сессии в часах (рекомендуется 12-24).
PORTAL_SESSION_TTL_HOURS=24
#
# Secure-флаг cookie: auto = по схеме запроса (https → secure), true/false —
# принудительно. За cf-tunnel/nginx (https) подходит auto.
PORTAL_COOKIE_SECURE=auto

# --- ЖУРНАЛ ДЕЙСТВИЙ (action log) ---
# Сквозной журнал всех действий для разбора ошибок: HTTP-запросы портала,
# переходы этапов конвейера, WARNING/ERROR из logging. Суточные JSONL в
# logs/actions/. Default ON (fail-soft). Чтение: GET /api/action-log,
# python scripts/analyze_action_log.py. Подробности: docs/action_log.md
# ACTION_LOG_ENABLED=true
# ACTION_LOG_RETENTION_DAYS=180
# ACTION_LOG_HTTP_ENABLED=true
# ACTION_LOG_PIPELINE_ENABLED=true
# ACTION_LOG_APPLOG_ENABLED=true
# ACTION_LOG_MAX_DAY_BYTES=268435456   # потолок суточного файла (защита диска)
# ACTION_LOG_APPLOG_MAX_PER_MIN=600    # потолок app_log-событий в минуту
# AUDIT_ACTION_LOG_DIR=            # кастомный путь вместо DATA_DIR/logs/actions
# ACTION_LOG_NOISE_EXTRA=          # CSV из regex — доп. шумовые пути

# --- PAID API KILL-SWITCH ---
# PAID_API_ENABLED=false       → guard блокирует все платные внешние вызовы
# PAID_API_DAILY_LIMIT_USD=N   → жёсткий потолок $/день; 0 = без лимита
# PAID_API_MONTHLY_LIMIT_USD=N → месячный бюджет для панели (индикатор, не hard cap)
PAID_API_ENABLED=false
PAID_API_DAILY_LIMIT_USD=0.0
PAID_API_MONTHLY_LIMIT_USD=250.0

# --- Внешние провайдеры (опционально) ---
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# --- Classic Audit: Codex exec через подписку ChatGPT/Codex (экспериментально) ---
# Доступно в конфигурации моделей стадий как model id `codex/gpt-5.4`.
# Агентные стадии пишут JSON-файлы в workspace, поэтому sandbox по умолчанию workspace-write.
# AUDIT_CODEX_MODEL=gpt-5.4
# AUDIT_CODEX_STAGE_MODEL=codex/gpt-5.4
# AUDIT_CODEX_SANDBOX=workspace-write
# AUDIT_CODEX_CLI_PATH=/home/coder/.vscode-server/extensions/openai.chatgpt-*/bin/linux-x86_64/codex

# Stage 01 `GPT + Codex`: independent detectors -> semantic comparison ->
# optional search for findings missed by both. The review uses Codex subscription
# and does not add OpenRouter spend. Both switches affect only ensemble/gpt-codex.
# STAGE01_DUAL_REVIEW_ENABLED=true
# STAGE01_DUAL_GAP_SEARCH_ENABLED=true
# STAGE01_DUAL_REVIEW_MODEL=codex/gpt-5.4

# Text-layer highlights: deterministic fitz word grounding, zero LLM tokens.
# Enable the worker first in shadow mode; it writes
# textlayer_highlights_shadow.json without changing 03_findings.json.
# PIPELINE_TEXTLAYER_HIGHLIGHTS_ENABLED=true
# PIPELINE_TEXTLAYER_HIGHLIGHTS_SHADOW=true
# PIPELINE_TEXTLAYER_HIGHLIGHTS_OVERRIDE_EXISTING=false

# --- Локальный LM Studio ---
# Два режима авторизации (CHANDRA_AUTH_MODE):
#   basic  — legacy: LM Studio за ngrok + Basic Auth (NGROK_AUTH_USER / NGROK_AUTH_PASS).
#   bearer — новый удалённый сервер (напр. https://01.vibe.cloud-ip.cc) с Bearer-токеном.
# Base URL можно задавать с /v1 и без — нормализуется.
#
# (A) Legacy ngrok + Basic Auth:
# CHANDRA_BASE_URL=https://your-ngrok-url
# CHANDRA_AUTH_MODE=basic
# NGROK_AUTH_USER=
# NGROK_AUTH_PASS=
#
# (B) Новый сервер + Bearer + OpenAI-транспорт (native /api/v1/chat отсутствует):
# LMSTUDIO_BASE_URL=https://01.vibe.cloud-ip.cc/v1   # или CHANDRA_BASE_URL, с /v1 и без
# LMSTUDIO_API_KEY=<токен>                            # или CHANDRA_BEARER_TOKEN; НЕ коммитить
# CHANDRA_AUTH_MODE=bearer
# CHANDRA_CHAT_TRANSPORT=openai_completions           # мультимодалку слать в /v1/chat/completions
# CHANDRA_GEMMA_MODEL=chandra-ocr-2                    # id OCR/enrichment-модели нового сервера
# LMSTUDIO_AUTO_RELOAD_ENABLED=false                  # модели предзагружены, reload не нужен
# GEMMA_ADAPTIVE_RELOAD_ENABLED=false
# LMSTUDIO_UNLOAD_AFTER_QUEUE=false

# --- Векторные графы блоков (block_context): параллелизм разбора ---
# Разбор блока — чистый CPU (fitz + геометрия профиля). Считается в пуле
# ПРОЦЕССОВ, общем для всех проектов очереди (в потоках упирался в GIL:
# несколько проектов «Выполняется», а считает одно ядро).
# По умолчанию min(8, ядра - 2). 1 — вернуть прежний последовательный режим.
# Это ЛИМИТ ОДНОВРЕМЕННОСТИ разбора; размер самого пула — CPU_POOL_WORKERS.
# BLOCK_CONTEXT_WORKERS=8

# --- Общий пул процессов для CPU-тяжёлых этапов ---
# Пул ОДИН на процесс бэкенда и общий для всех проектов очереди: это тот
# бюджет ядер, который делят параллельные проекты. Два независимых пула дали
# бы 2×(ядра−2) воркеров и задушили бы сам бэкенд.
# По умолчанию min(8, ядра − 2).
# CPU_POOL_WORKERS=8
# Привязать каждый воркер к своему ядру (locality кэша, нет миграции задач).
# Осмысленно при ровной CPU-нагрузке и нескольких проектах сразу; для
# смешанной нагрузки свободный планировщик обычно не хуже. По умолчанию off.
# CPU_POOL_PIN_CORES=false

# --- Параллельная обработка очереди проектов ---
# Сколько проектов очередь ведёт ОДНОВРЕМЕННО. 1 (по умолчанию) — прежняя
# строго последовательная обработка: item исполняется в самой корутине
# __BATCH__, от чего зависят cancel() и cleanup_zombies.
# ПОДНИМАТЬ ТОЛЬКО ВМЕСТЕ С БЮДЖЕТАМИ НИЖЕ: пять проектов без них дают ~20
# одновременных CLI-процессов и до 10 норм-MCP по ~2,8 ГБ — это OOM.
# BATCH_MAX_PARALLEL=5

# --- Глобальные бюджеты внешних ресурсов (на весь бэкенд, не на проект) ---
# Все лимиты параллелизма внутри этапов — «на проект», поэтому при N проектах
# каждый умножается на N. Эти бюджеты — единственный общий потолок.
# BUDGET_CLAUDE_CLI=6      # одновременных `claude -p`
# BUDGET_CODEX_CLI=6       # одновременных `codex exec` (Node-процессы)
# BUDGET_NORMS_MCP=2       # про RAM: норм-MCP ~2,8 ГБ на КАЖДЫЙ процесс CLI
# BUDGET_LOCAL_LLM=1       # модель на машине одна; >1 = пинг-понг перезагрузок

# --- Stage Comparison: allowlist исходных папок ---
# AUDIT_STAGE_COMPARISON_ROOTS=/abs/path/to/comparison_sources

# --- Stage Comparison Text LLM (Claude Code subscription) ---
STAGE_COMPARISON_TEXT_LLM_ENABLED=false
STAGE_COMPARISON_TEXT_LLM_PROVIDER=claude_code
STAGE_COMPARISON_TEXT_LLM_MODEL=claude-sonnet-5
STAGE_COMPARISON_TEXT_LLM_TIMEOUT_SEC=720
STAGE_COMPARISON_TEXT_LLM_MAX_CHARS=350000

# --- Stage Comparison Unified Analysis (Claude Opus via subscription) ---
# Используется в unified pipeline: enriched MD (Qwen) → Claude Opus для
# смыслового сравнения стадий. Внешний Anthropic API НЕ дёргается — только
# Claude Code subscription через CLI.
STAGE_COMPARISON_ENRICHED_COMPARE_ENABLED=false
STAGE_COMPARISON_ENRICHED_COMPARE_PROVIDER=claude_code
STAGE_COMPARISON_ENRICHED_COMPARE_MODEL=claude-opus-5
STAGE_COMPARISON_ENRICHED_COMPARE_TIMEOUT_SEC=900
STAGE_COMPARISON_ENRICHED_COMPARE_MAX_CHARS=600000

# --- Stage Comparison Graphic LLM (Local OpenAI-compatible / LM Studio) ---
# Активирует локальный VLM provider для графического сравнения в разделе
# «Сравнение стадий». Использует только local LM Studio endpoint.
# Auth: basic (ngrok, NGROK_AUTH_USER/PASS) ИЛИ bearer (новый сервер).
#   bearer: STAGE_COMPARISON_GRAPHIC_LLM_AUTH=bearer, токен берётся из
#           STAGE_COMPARISON_GRAPHIC_LLM_BEARER_TOKEN → CHANDRA_BEARER_TOKEN → LMSTUDIO_API_KEY.
#   На новом сервере native /api/v1/models отсутствует → ENABLE_MODEL_LOAD=false
#   (модели предзагружены; health-gate опирается на live /v1/chat/completions).
#   base_url можно с /v1 и без (нормализуется); пусто → fallback на CHANDRA_BASE_URL.
#
# Не использует OpenRouter / Gemini / api.openai.com / anthropic.com.
# По умолчанию provider=existing (старое поведение).
#
# STAGE_COMPARISON_GRAPHIC_LLM_PROVIDER=local_openai_compatible
# STAGE_COMPARISON_GRAPHIC_LLM_BASE_URL=https://your-ngrok-url   # (bearer: https://01.vibe.cloud-ip.cc/v1)
# STAGE_COMPARISON_GRAPHIC_LLM_MODEL=qwen/qwen3.6-35b-a3b        # (bearer: qwen36-27b-mtp)
# STAGE_COMPARISON_GRAPHIC_LLM_FALLBACK_MODEL=qwen3.6-35b-a3b-mtp
# STAGE_COMPARISON_GRAPHIC_LLM_TEMPERATURE=0.0
# STAGE_COMPARISON_GRAPHIC_LLM_MAX_TOKENS=5500   # рекомендуемый default (compact v4 prompt).
                                                  # Live benchmark 2026-05-26 (4 heavy HVAC blocks):
                                                  #   max=4000  → 2/4 success, avg 96s, max 266s (V2 + fallback mtp)
                                                  #   max=5500  → 4/4 success, avg 27s, max 32s  ← default
                                                  #   max=7500  → 4/4 success, avg 34s, max 43s — больше деталей, slower
# STAGE_COMPARISON_GRAPHIC_LLM_MAX_CONTINUATIONS=3  # primary + до 3 continuations при continues=true
                                                    # (на v4 prompt'е каждый primary упирается в length →
                                                    # salvage возвращает partial → continuation добивает)
# STAGE_COMPARISON_GRAPHIC_LLM_TIMEOUT_SEC=300
# STAGE_COMPARISON_GRAPHIC_LLM_IMAGE_LONG_SIDE=1100
# STAGE_COMPARISON_GRAPHIC_LLM_AUTH=basic        # basic | bearer
# STAGE_COMPARISON_GRAPHIC_LLM_BEARER_TOKEN=      # только для bearer; НЕ коммитить
# STAGE_COMPARISON_GRAPHIC_LLM_ENABLE_MODEL_LOAD=true   # bearer/новый сервер → false
# STAGE_COMPARISON_GRAPHIC_LLM_LOAD_CONTEXT_LENGTH=16000
#
# Защита LM Studio:
#   PROTECT_MODELS — CSV-список model_key, которые нельзя выгружать. По
#                    умолчанию chandra-ocr-2 (production OCR). Если эта модель
#                    была loaded до запроса и пропадёт после load qwen —
#                    автоматически восстанавливается через /api/v1/models/load
#                    с config из pre-request snapshot, с warning'ом.
#   UNLOAD_AFTER_REQUEST — после успешного single graphic-diff выгружать
#                          primary/fallback (но не PROTECT_MODELS).
#   UNLOAD_AFTER_BATCH   — то же, но в конце batch job.
# STAGE_COMPARISON_GRAPHIC_LLM_PROTECT_MODELS=chandra-ocr-2
# STAGE_COMPARISON_GRAPHIC_LLM_UNLOAD_AFTER_REQUEST=false
# STAGE_COMPARISON_GRAPHIC_LLM_UNLOAD_AFTER_BATCH=false

# ── Гуманизация ссылок на блоки в текстах замечаний ─────────────────────────
# После findings_merge внутренние block_id («6L97-3VTH-XTC») в видимых текстах
# (problem/description/solution/risk) заменяются подписями «Название» (лист N,
# стр. PDF M) из 01_blocks_analysis/document_graph; найденные в тексте ID
# переносятся в related_block_ids. Детерминированно, офлайн, идемпотентно,
# fail-soft. Default ON; false — вернуть сырые ID в текстах (не рекомендуется).
# FINDINGS_BLOCK_CAPTIONS_ENABLED=true

# === Графический агент тиражирования (section optimization) ===
# Сколько блоков целевого проекта уходит в платный vision-вызов. 0 = выключить
# графическую проверку целиком (вызова не будет).
SECTION_OPTIMIZATION_GRAPHICS_TARGET_BLOCKS=3
# Сколько блоков исходного проекта прикладывать как контекст. 0 = не прикладывать.
SECTION_OPTIMIZATION_GRAPHICS_SOURCE_BLOCKS=2
# Таймаут одного vision-вызова, сек.
SECTION_OPTIMIZATION_GRAPHICS_TIMEOUT_SEC=900
# Глубина рассуждений графического агента: minimal|low|medium|high|xhigh
SECTION_OPTIMIZATION_GRAPHICS_REASONING_EFFORT=high
