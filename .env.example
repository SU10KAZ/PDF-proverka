# PDF-proverka — пример .env (не коммитить реальные секреты).

# --- PORTAL AUTH (простая защита портала логином/паролем) ---
# Лёгкая session-cookie аутентификация для 3-4 сотрудников. Без БД, ролей,
# регистрации. По умолчанию ВЫКЛЮЧЕНА — портал работает как раньше.
#
# Включить защиту:
PORTAL_AUTH_ENABLED=false
#
# Список учёток: 'логин:pbkdf2-хеш' через запятую. ВАЖНО: значение в ОДИНАРНЫХ
# кавычках — хеш содержит '$', иначе .env-загрузчик попытается раскрыть его как
# переменную. Хеш генерируется helper-скриптом (см. ниже), пароли в открытом
# виде НЕ хранятся.
#   python backend/scripts/hash_portal_password.py --user ivan
# PORTAL_AUTH_USERS='ivan:$pbkdf2-sha256$29000$...,petr:$pbkdf2-sha256$29000$...'
#
# Секрет для подписи session-cookie (длинная случайная строка). Без него
# сессии живут только до рестарта процесса.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PORTAL_SESSION_SECRET=
#
# Срок жизни сессии в часах (рекомендуется 12-24).
PORTAL_SESSION_TTL_HOURS=24
#
# Secure-флаг cookie: auto = по схеме запроса (https → secure), true/false —
# принудительно. За cf-tunnel/nginx (https) подходит auto.
PORTAL_COOKIE_SECURE=auto

# --- ЖУРНАЛ ДЕЙСТВИЙ (action log) ---
# Сквозной журнал всех действий для разбора ошибок: HTTP-запросы портала,
# переходы этапов конвейера, WARNING/ERROR из logging. Суточные JSONL в
# logs/actions/. Default ON (fail-soft). Чтение: GET /api/action-log,
# python scripts/analyze_action_log.py. Подробности: docs/action_log.md
# ACTION_LOG_ENABLED=true
# ACTION_LOG_RETENTION_DAYS=180
# ACTION_LOG_HTTP_ENABLED=true
# ACTION_LOG_PIPELINE_ENABLED=true
# ACTION_LOG_APPLOG_ENABLED=true
# ACTION_LOG_MAX_DAY_BYTES=268435456   # потолок суточного файла (защита диска)
# ACTION_LOG_APPLOG_MAX_PER_MIN=600    # потолок app_log-событий в минуту
# AUDIT_ACTION_LOG_DIR=            # кастомный путь вместо DATA_DIR/logs/actions
# ACTION_LOG_NOISE_EXTRA=          # CSV из regex — доп. шумовые пути

# --- PAID API KILL-SWITCH ---
# PAID_API_ENABLED=false       → guard блокирует все платные внешние вызовы
# PAID_API_DAILY_LIMIT_USD=N   → жёсткий потолок $/день; 0 = без лимита
# PAID_API_MONTHLY_LIMIT_USD=N → месячный бюджет для панели (индикатор, не hard cap)
PAID_API_ENABLED=false
PAID_API_DAILY_LIMIT_USD=0.0
PAID_API_MONTHLY_LIMIT_USD=250.0

# --- Внешние провайдеры (опционально) ---
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# --- Classic Audit: Codex exec через подписку ChatGPT/Codex (экспериментально) ---
# Доступно в конфигурации моделей стадий как model id `codex/gpt-6-astra`.
# Агентные стадии пишут JSON-файлы в workspace, поэтому sandbox по умолчанию workspace-write.
# AUDIT_CODEX_MODEL=gpt-6-astra
# AUDIT_CODEX_STAGE_MODEL=codex/gpt-6-astra
# AUDIT_CODEX_SANDBOX=workspace-write
# AUDIT_CODEX_CLI_PATH=/home/coder/.vscode-server/extensions/openai.chatgpt-*/bin/linux-x86_64/codex

# Stage 01 `GPT + Codex`: independent detectors -> semantic comparison ->
# optional search for findings missed by both. The review uses Codex subscription
# and does not add OpenRouter spend. Both switches affect only ensemble/gpt-codex.
# STAGE01_DUAL_REVIEW_ENABLED=true
# STAGE01_DUAL_GAP_SEARCH_ENABLED=true
# STAGE01_DUAL_REVIEW_MODEL=codex/gpt-6-astra

# Остановка этапа 01, если нога ансамбля не ответила. Без этого блок считается
# успешным при одной выжившей ноге, а стадия — при одном уцелевшем блоке:
# исчерпание лимита провайдера даёт аудит «выполнено» с урезанным рекаллом.
# При включении стадия падает с текстом, какая нога упала и на каком блоке;
# уже запущенные блоки доигрывают, новые не стартуют. THRESHOLD — сколько
# блоков с выпавшей ногой терпим до остановки.
# STAGE01_ABORT_ON_LEG_FAILURE_ENABLED=false
# STAGE01_LEG_FAILURE_THRESHOLD=1

# --- Повтор транзиентных отказов GPT/OpenRouter на Stage 01 ---
# Сетевой обрыв, 408/409/429 и 5xx повторяются с exponential backoff
# и джиттером до того, как выпавшая нога остановит аудит. Фатальные
# 4xx не повторяются. RETRIES — число ДОПОЛНИТЕЛЬНЫХ попыток (0..5).
# Полный httpx-timeout повторяется не более одного раза из-за общего лимита блока.
# STAGE01_OPENROUTER_TRANSIENT_RETRIES=2
# STAGE01_OPENROUTER_RETRY_BASE_DELAY_S=2.0

# --- Повтор транзиентных отказов codex (codex_runner) ---
# 11.08: `codex exec --model gpt-5.6-sol` отдал за 6.9 с
#   {"type":"error","message":"Selected model is at capacity."}
# и exit 1 без `-o` файла. При THRESHOLD=1 это уронило Stage 01 на 59-м из 135
# блоков: 17.5 минут и $2.26 в никуда. Теперь перегрузка/429/5xx/обрыв связи
# повторяются с экспоненциальным backoff и джиттером (джиттер обязателен: без
# него два десятка параллельных ног бьют по перегруженной модели одной волной).
# Исчерпание лимита подписки, отказ авторизации и таймаут стадии НЕ повторяются.
# RETRIES — сколько ДОПОЛНИТЕЛЬНЫХ попыток после первой (0 = поведение до фикса,
# потолок 5). Задержка: BASE × 2^(попытка-1) + джиттер до +50%.
# CODEX_TRANSIENT_RETRIES=2
# CODEX_TRANSIENT_RETRY_BASE_DELAY_S=3.0

# Text-layer highlights: deterministic fitz word grounding, zero LLM tokens.
# Enable the worker first in shadow mode; it writes
# textlayer_highlights_shadow.json without changing 03_findings.json.
# PIPELINE_TEXTLAYER_HIGHLIGHTS_ENABLED=true
# PIPELINE_TEXTLAYER_HIGHLIGHTS_SHADOW=true
# PIPELINE_TEXTLAYER_HIGHLIGHTS_OVERRIDE_EXISTING=false


# --- Векторные графы блоков (block_context): параллелизм разбора ---
# Разбор блока — чистый CPU (fitz + геометрия профиля). Считается в пуле
# ПРОЦЕССОВ, общем для всех проектов очереди (в потоках упирался в GIL:
# несколько проектов «Выполняется», а считает одно ядро).
# По умолчанию min(8, ядра - 2). 1 — вернуть прежний последовательный режим.
# Это ЛИМИТ ОДНОВРЕМЕННОСТИ разбора; размер самого пула — CPU_POOL_WORKERS.
# BLOCK_CONTEXT_WORKERS=8

# --- Общий пул процессов для CPU-тяжёлых этапов ---
# Пул ОДИН на процесс бэкенда и общий для всех проектов очереди: это тот
# бюджет ядер, который делят параллельные проекты. Два независимых пула дали
# бы 2×(ядра−2) воркеров и задушили бы сам бэкенд.
# По умолчанию min(8, ядра − 2).
# CPU_POOL_WORKERS=8
# Привязать каждый воркер к своему ядру (locality кэша, нет миграции задач).
# Осмысленно при ровной CPU-нагрузке и нескольких проектах сразу; для
# смешанной нагрузки свободный планировщик обычно не хуже. По умолчанию off.
# CPU_POOL_PIN_CORES=false

# --- Параллельная обработка очереди проектов ---
# Сколько проектов очередь ведёт ОДНОВРЕМЕННО. 1 (по умолчанию) — прежняя
# строго последовательная обработка: item исполняется в самой корутине
# __BATCH__, от чего зависят cancel() и cleanup_zombies.
# ПОДНИМАТЬ ТОЛЬКО ВМЕСТЕ С БЮДЖЕТАМИ НИЖЕ: пять проектов без них дают ~20
# одновременных CLI-процессов и до 10 норм-MCP по ~2,8 ГБ — это OOM.
# BATCH_MAX_PARALLEL=5

# --- Глобальные бюджеты внешних ресурсов (на весь бэкенд, не на проект) ---
# Все лимиты параллелизма внутри этапов — «на проект», поэтому при N проектах
# каждый умножается на N. Эти бюджеты — единственный общий потолок.
# BUDGET_CLAUDE_CLI=6      # одновременных `claude -p`
# BUDGET_CODEX_CLI=20      # одновременных `codex exec` (статический Rust-бинарь,
#                          # 310 МБ текста расшарены между инстансами, RSS мал).
#                          # Дефолт в коде — 6; для Full Codex при 5 проектах
#                          # ставить 20 = пик спроса (5 × 2 блока × 2 codex-ноги),
#                          # иначе очередь упирается в бюджет, а не в железо.
# BUDGET_NORMS_MCP=5       # про RAM, самая дорогая ручка: одна сессия норм-MCP
#                          # после первого semantic_search держит 5,6 ГБ и не
#                          # выгружает до конца сессии. Считать: свободная RAM
#                          # / 5,6 с запасом. Дефолт в коде — 2, он рассчитан
#                          # под хост с 11 ГБ; на 62 ГБ ставим 5 (по одной
#                          # на проект). ПЕРЕСЧИТЫВАТЬ ПРИ СМЕНЕ МАШИНЫ.

# --- Stage Comparison: allowlist исходных папок ---
# Legacy/history-only roots. Новые загрузки хранятся в
# projects_v2/objects/<object>/comparison и не зависят от этой настройки.
# AUDIT_STAGE_COMPARISON_ROOTS=/abs/path/to/comparison_sources
# Лимиты безопасной загрузки ZIP для stage_1/stage_2 (необязательно):
# STAGE_COMPARISON_UPLOAD_MAX_ARCHIVE_BYTES=2147483648
# STAGE_COMPARISON_UPLOAD_MAX_UNPACKED_BYTES=10737418240
# STAGE_COMPARISON_UPLOAD_MAX_MEMBERS=20000

# Function Lineage production shadow: the flag only arms the contour. It runs
# for STANDARD only and still requires an exact pair_id OR run_id allowlist
# match. Empty allowlists always mean zero Function Lineage model calls.
AI_FUNCTION_LINEAGE_SHADOW_ENABLED=false
AI_FUNCTION_LINEAGE_SHADOW_PAIR_ALLOWLIST=
# AI_FUNCTION_LINEAGE_SHADOW_RUN_ALLOWLIST=

# ── Гуманизация ссылок на блоки в текстах замечаний ─────────────────────────
# После findings_merge внутренние block_id («6L97-3VTH-XTC») в видимых текстах
# (problem/description/solution/risk) заменяются подписями «Название» (лист N,
# стр. PDF M) из 01_blocks_analysis/document_graph; найденные в тексте ID
# переносятся в related_block_ids. Детерминированно, офлайн, идемпотентно,
# fail-soft. Default ON; false — вернуть сырые ID в текстах (не рекомендуется).
# FINDINGS_BLOCK_CAPTIONS_ENABLED=true

# === Графический агент тиражирования (section optimization) ===
# Сколько блоков целевого проекта уходит в платный vision-вызов. 0 = выключить
# графическую проверку целиком (вызова не будет).
SECTION_OPTIMIZATION_GRAPHICS_TARGET_BLOCKS=3
# Сколько блоков исходного проекта прикладывать как контекст. 0 = не прикладывать.
SECTION_OPTIMIZATION_GRAPHICS_SOURCE_BLOCKS=2
# Таймаут одного vision-вызова, сек.
SECTION_OPTIMIZATION_GRAPHICS_TIMEOUT_SEC=900
# Глубина рассуждений графического агента: minimal|low|medium|high|xhigh
SECTION_OPTIMIZATION_GRAPHICS_REASONING_EFFORT=high

# === Распределённые audit-worker (этап 0: вертикальный срез) ===
# Подсистема выдачи заданий сторонним VPS. Этап 0 умеет ТОЛЬКО безопасное
# тестовое задание test_pipeline_v1: реальный аудит, Claude Code, Codex и
# нормативный этап не подключены. См. docs/distributed_audit_workers/.
#
# Kill-switch. При false: роутеры не регистрируются (404), SQLite-база НЕ
# создаётся, фоновых задач нет, экран показывает «функция отключена».
# Существующий конвейер не затрагивается при любом значении.
DISTRIBUTED_WORKERS_ENABLED=false

# ─── Роли подсистемы распределённых воркеров ────────────────────────────────
# Кто и что вправе делать на экране «Аудит-воркеры». Списки ЛОГИНОВ портала
# (те же имена, что в PORTAL_AUTH_USERS), через запятую.
#
# Правила намеренно строгие:
#   * пустой список не даёт прав НИКОМУ — это fail-closed, а не сбой;
#   * шаблоны и «*» запрещены: один символ не должен отключать защиту;
#   * совпадение точное, регистр учитывается;
#   * при PORTAL_AUTH_ENABLED=false изменяющие ручки закрыты в любом случае:
#     субъекта нет, значит проверять право не у кого.
#
#   viewer   — только просмотр: воркеры, задания, попытки, прогресс, логи;
#   operator — плюс управление ЗАДАНИЯМИ: выдать тест, отменить попытку,
#              признать потерянной, создать новую, заказать удаление данных;
#   admin    — плюс управление ВОРКЕРАМИ и безопасностью: одобрить, отклонить,
#              отозвать, ротировать токен, читать сводный журнал решений.
# Candidate mapping из фактических production portal subjects. Этот файл
# не меняет production users; mapping вступит в силу только после
# отдельного install/restart approval.
DISTRIBUTED_WORKERS_VIEWER_SUBJECTS=igor,alexey,filipp,marina,alexandra
DISTRIBUTED_WORKERS_OPERATOR_SUBJECTS=
DISTRIBUTED_WORKERS_ADMIN_SUBJECTS=andrey
# Корень состояния подсистемы (workers.db + пакеты + логи заданий).
DISTRIBUTED_WORKERS_DATA_DIR=/var/lib/auditmanager/distributed_workers
# Регистрация машин принимает только one-time, TTL, bootstrap-session- и
# instance-scoped token. Центр хранит только SHA-256; reusable shared fallback нет.
# # Операторский контур /api/workers/* защищён ТОЛЬКО портальной авторизацией.
# При PORTAL_AUTH_ENABLED=false он не поднимается вовсе: rotate-token отдаёт
# живой токен воркера открытым текстом. true — осознанный dev-режим.
DISTRIBUTED_WORKERS_ALLOW_INSECURE_ADMIN=false

# Пороги оси СВЯЗИ (не исполнения!): молчание воркера меняет только индикатор
# и НИКОГДА не переводит задание в failed.
DISTRIBUTED_WORKERS_HEARTBEAT_STALE_SEC=90
DISTRIBUTED_WORKERS_HEARTBEAT_OFFLINE_SEC=600
# Потолок размера пакета в любую сторону (защита диска и от «бомбы»), байт.
DISTRIBUTED_WORKERS_MAX_PACKAGE_BYTES=2147483648
# Размер чанка загрузки результата. Держать НИЖЕ nginx client_max_body_size
# (на проде 200M), иначе результат не пролезет.
DISTRIBUTED_WORKERS_UPLOAD_CHUNK_BYTES=33554432
# Потолок ожидания в long-poll выдачи задания, сек.
DISTRIBUTED_WORKERS_LONG_POLL_SEC=25
# Потолок суммарной длительности тестового задания, сек (воркер зажимает повторно).
DISTRIBUTED_WORKERS_TEST_JOB_MAX_SEC=300
