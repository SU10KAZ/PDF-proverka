# === Paid API guard runtime state (forensic, локальные данные) ===
# Append-only журналы платных API: пишутся pipeline'ом при каждом успешном
# вызове и каждой блокировке. В git их не пускаем.
backend/app/data/paid_cost_events.jsonl
backend/app/data/paid_api_blocked_events.jsonl
webapp/data/paid_cost_events.jsonl
webapp/data/paid_api_blocked_events.jsonl

# === Runtime usage / paid-cost state (локальные данные) ===
# Агрегированные счётчики usage и платной стоимости пишутся pipeline'ом
# в рантайме; держим их вне git, чтобы не было постоянного dirty-хвоста.
backend/app/data/usage_data.json
backend/app/data/paid_cost.json

# === Stage Comparison runtime (раздел «Сравнение стадий») ===
# Сессии, рендеренные страницы PDF, crop'ы блоков, alignment-карты, diff'ы
# и т.п. — всё runtime; в git идёт только .gitkeep.
comparison/*
!comparison/.gitkeep

# === Stage Comparison sources (исходные PDF/MD/JSON для сравнения) ===
# Реальные документы сравниваемых стадий храним локально; в git идут
# только README.md и .gitkeep (структура папок).
comparison_sources/**/*
!comparison_sources/README.md
!comparison_sources/**/
!comparison_sources/**/README.md
!comparison_sources/**/.gitkeep

