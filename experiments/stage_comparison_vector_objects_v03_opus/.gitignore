# Тяжёлые промежуточные данные и растры не коммитятся: каталог целиком весит 473 МБ.
# Всё перечисленное ниже пересоздаётся зондами из probes/ по командам в разделе
# «Reproduction» соответствующего artifacts/<префикс>_FINDINGS.md.
#
# В репозиторий попадают: код зондов, отчёты (*_FINDINGS.md, *_VERIFY.md), схемы контракта
# и сводные JSON — то есть всё, на что ссылаются утверждения отчёта.

# растровые выгрузки (кропы, оверлеи, контактные листы, триптихи контрфактов)
*.png
*.jpg

# построчные дампы полного корпуса (десятки МБ, пересоздаются за минуты)
*.jsonl

# крупные прогоны и манифесты
artifacts/cf_manifest.json
artifacts/cf_runs.json
artifacts/pd_stage_census.json

# каталоги прогонов и визуальных выгрузок
