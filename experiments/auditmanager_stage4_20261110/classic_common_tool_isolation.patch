+def _has_tool_activity(stdout: str) -> bool:
+    """Inspect CLI item events, not text quoted inside a model response."""
+    for line in stdout.splitlines():
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict) or not str(event.get("type", "")).startswith("item."):
+            continue
+        item = event.get("item")
+        if isinstance(item, dict) and item.get("type") not in ("agent_message", "reasoning"):
+            return True
+    return False
