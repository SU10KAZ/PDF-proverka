{
  "base_path": "/api/v1/worker",
  "transport": "outbound HTTPS polling",
  "actions": [
    {"action":"register","endpoint":"POST /register","handler":"register","request":"RegisterRequest","response":"RegisterResponse","identifiers":["instance_id"],"persistence":"worker registration + claim-secret hash","idempotency":"same instance reuses pending registration; rate limited","retry":"retry network/5xx; approval remains central","security":"registration token scope; one-time claim secret returned only here"},
    {"action":"claim","endpoint":"POST /claim","handler":"claim","request":"ClaimRequest","response":"ClaimResponse","identifiers":["worker_id","instance_id"],"persistence":"claim consumed; worker bearer-token hash stored","idempotency":"single use; replay is 409","retry":"inspect registration after ambiguous response","security":"claim secret exchanged once; worker token shown once"},
    {"action":"registration_update","endpoint":"PUT /registration","handler":"update_registration","request":"RegistrationUpdateRequest","response":"worker registration snapshot","identifiers":["worker_id","instance_id"],"persistence":"revision/capabilities update","idempotency":"last-write same semantic snapshot","retry":"safe with same body","security":"worker bearer token"},
    {"action":"heartbeat","endpoint":"POST /heartbeat","handler":"heartbeat","request":"HeartbeatRequest","response":"HeartbeatResponse","identifiers":["worker_id","instance_id","job_id","attempt_id"],"persistence":"worker liveness/resources/provider snapshot; cursors read","idempotency":"observational upsert","retry":"next heartbeat or immediate reconnect; missing heartbeat changes connectivity only","security":"worker bearer; provider snapshots sanitized"},
    {"action":"resources","endpoint":"POST /resources","handler":"post_resources","request":"ResourceSnapshot","response":"ack","identifiers":["worker_id"],"persistence":"resource snapshot","idempotency":"observational upsert","retry":"safe","security":"worker bearer; bounded/sanitized"},
    {"action":"poll_claim","endpoint":"POST /jobs/next","handler":"jobs_next","request":"JobsNextRequest","response":"JobAssignment or 204","identifiers":["worker_id","job_id","attempt_id","attempt_no"],"persistence":"atomic central claim/assignment before response","idempotency":"existing assigned attempt returned; slots checked centrally","retry":"long-poll retry; assignment lease survives lost response","security":"worker bearer; capability/revision/provider/slot gates"},
    {"action":"source_download","endpoint":"GET /jobs/{job_id}/source","handler":"download_source","request":"job_id + X-Execution-Token","response":"source archive bytes","identifiers":["job_id","attempt_id","package_id"],"persistence":"immutable source package","idempotency":"byte-identical GET/range-capable HTTP semantics","retry":"repeat/resume download and verify hash/manifest","security":"worker bearer + per-attempt execution token; boundary checks"},
    {"action":"accept","endpoint":"POST /jobs/{job_id}/accept","handler":"accept_job","request":"AcceptRequest + X-Execution-Token","response":"job state","identifiers":["job_id","attempt_id"],"persistence":"accepted_by_worker transition after source verification","idempotency":"Idempotency-Key response store; repeated accepted state safe","retry":"same key/body; body mismatch is 409","security":"worker bearer + attempt execution token"},
    {"action":"decline","endpoint":"POST /jobs/{job_id}/reject","handler":"reject_job","request":"RejectRequest + X-Execution-Token","response":"job state","identifiers":["job_id","attempt_id"],"persistence":"attempt rejection/requeue decision","idempotency":"attempt-scoped guarded transition","retry":"same attempt/reason","security":"worker bearer + attempt execution token"},
    {"action":"events","endpoint":"POST /events","handler":"post_events","request":"EventBatchRequest + X-Execution-Token","response":"EventBatchResponse","identifiers":["worker_id","job_id","attempt_id","event_id","seq"],"persistence":"events/log plus highest contiguous cursor","idempotency":"dedupe by attempt/event sequence; duplicates counted skipped","retry":"EventOutbox resends unacked tail from last_seen_seq","security":"worker bearer + attempt token; event type closed and payload sanitized"},
    {"action":"upload_create","endpoint":"POST /uploads","handler":"create_upload","request":"UploadCreateRequest + X-Execution-Token","response":"UploadSessionInfo","identifiers":["job_id","attempt_id","upload_id","expected_hash"],"persistence":"resumable upload session","idempotency":"Idempotency-Key and existing session by result identity","retry":"recreate safely and query received chunks","security":"worker bearer + attempt token; size/hash limits"},
    {"action":"upload_status","endpoint":"GET /uploads/{upload_id}","handler":"get_upload","request":"upload_id + X-Execution-Token","response":"UploadSessionInfo","identifiers":["upload_id","job_id","attempt_id"],"persistence":"reads upload/chunk bitmap","idempotency":"read-only","retry":"safe","security":"worker bearer + attempt ownership/token"},
    {"action":"upload_chunk","endpoint":"PUT /uploads/{upload_id}/chunks/{idx}","handler":"put_chunk","request":"chunk bytes/hash","response":"chunk ack","identifiers":["upload_id","idx"],"persistence":"chunk file + received bitmap","idempotency":"same indexed chunk accepted; conflicting bytes rejected","retry":"send missing index only","security":"worker bearer + attempt token; bounded chunk/hash verification"},
    {"action":"upload_complete","endpoint":"POST /uploads/{upload_id}/complete","handler":"complete_upload","request":"UploadCompleteRequest + X-Execution-Token","response":"UploadCompleteResponse","identifiers":["upload_id","job_id","attempt_id","sha256"],"persistence":"assemble, validate, store result; state and retention ACK","idempotency":"Idempotency-Key; completion/result identity replay-safe","retry":"same key/body; validation rejection is typed domain failure","security":"worker bearer + attempt token; archive/hash/manifest/boundary validation"},
    {"action":"commands_get","endpoint":"GET /commands","handler":"get_commands","request":"cursor/limit","response":"WorkerCommandOut[]","identifiers":["worker_id","command_id"],"persistence":"command delivery state","idempotency":"undelivered/idempotent command may repeat","retry":"poll again","security":"worker bearer; closed command enum"},
    {"action":"commands_next","endpoint":"POST /commands/next","handler":"commands_next","request":"CommandsNextRequest","response":"WorkerCommandOut[]","identifiers":["worker_id","command_id"],"persistence":"long-poll command delivery state","idempotency":"same command_id may repeat until ack","retry":"long-poll retry","security":"worker bearer; no arbitrary command"},
    {"action":"command_ack","endpoint":"POST /commands/{command_id}/ack","handler":"ack_command","request":"CommandAckRequest","response":"ack","identifiers":["worker_id","command_id","job_id","attempt_id"],"persistence":"command result/ack; cancel state only after stopped proof","idempotency":"command_id is stable; repeated ACK does not recancel","retry":"safe with same result","security":"worker bearer; payload validated by command type"},
    {"action":"update_manifest","endpoint":"GET /update/manifest","handler":"update_manifest","request":"worker revision","response":"204 in current runtime","identifiers":["worker_id"],"persistence":"none","idempotency":"read-only","retry":"safe","security":"worker bearer; admin/update implementation is not stream control"},
    {"action":"reconcile","endpoint":"POST /reconcile","handler":"reconcile","request":"ReconcileRequest","response":"ReconcileResponse","identifiers":["worker_id","instance_id","job_id","attempt_id"],"persistence":"restart/reconnect reconciliation and retention/cursor decisions","idempotency":"authoritative center verdict per known attempt","retry":"repeat full local snapshot after reconnect","security":"worker bearer; no client authority over central job state"}
  ],
  "invariants": {
    "event_dedupe_key": ["job_id", "attempt_id", "seq"],
    "disconnect_does_not_fail_job": true,
    "result_auto_delete_before_validated_ack": false,
    "large_packages": "resumable HTTPS",
    "arbitrary_remote_execution": false
  }
