AUDIT_WORKER_ISSUER_SOCKET=/run/auditmanager-worker-issuer/issuer.sock
AUDIT_WORKER_ISSUER_CERT=/etc/auditmanager/pki/issuer/issuing-ca.pem
AUDIT_WORKER_ISSUER_KEY=/etc/auditmanager/pki/issuer/issuing-ca-key.pem
AUDIT_WORKER_ISSUER_CHAIN=/etc/auditmanager/pki/issuer/issuing-chain.pem
AUDIT_WORKER_GATEWAY_UID=__SET_GATEWAY_UID__
AUDIT_WORKER_CERT_LIFETIME_DAYS=30
DISTRIBUTED_WORKERS_ENABLED=true
DISTRIBUTED_WORKERS_DATA_DIR=/var/lib/auditmanager/distributed-workers
