[Unit]
Description=AuditManager web-ocr Agent Gateway (gRPC mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web-ocr-agent-gateway
Group=web-ocr-agent-gateway
WorkingDirectory=/opt/auditmanager/current
EnvironmentFile=/etc/auditmanager/agent-gateway.env
ExecStart=/opt/auditmanager/venv-gateway/bin/python -m backend.app.agent_gateway
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/auditmanager/pki/gateway
ReadOnlyPaths=/etc/auditmanager/pki/worker-trust
ReadWritePaths=/var/lib/auditmanager/distributed-workers
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
