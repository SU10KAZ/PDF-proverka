[Unit]
Description=AuditManager web-ocr Agent Gateway (gRPC mTLS)
After=network-online.target
After=web-ocr-worker-cert-issuer.service
Wants=network-online.target
Requires=web-ocr-worker-cert-issuer.service

[Service]
Type=simple
User=web-ocr-agent-gateway
Group=web-ocr-agent-gateway
WorkingDirectory=/opt/auditmanager/current/app
EnvironmentFile=/etc/auditmanager/agent-gateway.env
Environment=PYTHONPATH=/opt/auditmanager/current/app
ExecStart=/opt/auditmanager/current/venv/bin/python -m backend.app.agent_gateway
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/auditmanager/pki/gateway
ReadOnlyPaths=/etc/auditmanager/pki/worker-trust
ReadWritePaths=/var/lib/auditmanager/distributed_workers
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
