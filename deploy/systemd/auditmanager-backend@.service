[Unit]
Description=AuditManager immutable backend release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auditmanager
Group=auditmanager
WorkingDirectory=/opt/auditmanager/releases/%i/app
EnvironmentFile=/etc/auditmanager/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/auditmanager/releases/%i/venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=120s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/auditmanager/releases/%i
ReadWritePaths=/home/coder/projects/PDF-proverka
ReadWritePaths=/var/lib/auditmanager/distributed_workers
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
