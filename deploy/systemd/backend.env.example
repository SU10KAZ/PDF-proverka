# Existing AuditManager runtime data remains where production currently keeps it.
# This file is a candidate template only; it is not installed by 12F.1B.
AUDIT_DATA_DIR=/home/coder/projects/PDF-proverka
AUDIT_APP_DATA_DIR=/home/coder/projects/PDF-proverka/backend/app/data
COMPARISON_ROOT=/home/coder/projects/PDF-proverka/comparison

# Distributed state is outside every immutable release and survives switches.
DISTRIBUTED_WORKERS_DATA_DIR=/var/lib/auditmanager/distributed_workers

# Safe production defaults. Enabling the worker control plane and a canary are
# separate, explicit operator-approved steps. Every worker also starts with its
# durable intake_enabled=0 gate until an operator performs resume-intake.
DISTRIBUTED_WORKERS_ENABLED=false
DISTRIBUTED_AUDIT_EXECUTION_ENABLED=false
AUDIT_WORKER_ALLOW_REAL_LLM=false

# Candidate portal mapping; does not mutate portal users or passwords.
DISTRIBUTED_WORKERS_VIEWER_SUBJECTS=igor,alexey,filipp,marina,alexandra
DISTRIBUTED_WORKERS_OPERATOR_SUBJECTS=
DISTRIBUTED_WORKERS_ADMIN_SUBJECTS=andrey

# There is intentionally no reusable bootstrap secret. Registration accepts
# only hashed-at-rest, one-time, TTL, bootstrap-session + instance-scoped tokens.
PORTAL_AUTH_ENABLED=true
DISTRIBUTED_WORKERS_ALLOW_INSECURE_ADMIN=false
