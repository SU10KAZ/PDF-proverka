AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=8443
AGENT_GATEWAY_ENVIRONMENT=production
AGENT_GATEWAY_SECURITY_MODE=mtls
AGENT_GATEWAY_SERVER_CERT=/etc/auditmanager/pki/gateway/server-chain.pem
AGENT_GATEWAY_SERVER_KEY=/etc/auditmanager/pki/gateway/server-key.pem
AGENT_GATEWAY_CLIENT_CA_BUNDLE=/etc/auditmanager/pki/worker-trust/worker-ca-bundle.pem
AGENT_GATEWAY_SERVER_IDENTITY=176.12.77.128
AGENT_GATEWAY_CERT_CHECK_INTERVAL_SEC=2
AGENT_GATEWAY_ISSUER_SOCKET=/run/auditmanager-worker-issuer/issuer.sock
AGENT_GATEWAY_PROTOCOL_VERSIONS=1
AGENT_GATEWAY_HEALTH_ENABLED=true
AGENT_GATEWAY_METRICS_ENABLED=true
AGENT_GATEWAY_REFLECTION_ENABLED=false
AGENT_GATEWAY_LOG_LEVEL=INFO
DISTRIBUTED_WORKERS_ENABLED=true
DISTRIBUTED_WORKERS_DATA_DIR=/var/lib/auditmanager/distributed-workers
DISTRIBUTED_WORKERS_SHARED_STATE=true
